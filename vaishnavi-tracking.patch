diff --git a/track-order.html b/track-order.html
new file mode 100644
index 0000000..2488591
--- /dev/null
+++ b/track-order.html
@@ -0,0 +1,179 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Track Your Order | Vaishnavi Furniture</title>
+  <meta name="description" content="Track your Vaishnavi Furniture order — watch it move from received to delivered." />
+  <meta name="robots" content="noindex, follow" />
+  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
+  <style>
+    .stepper { display: flex; overflow-x: auto; padding: 1.2rem 0 0.6rem; }
+    .step { flex: 1 0 104px; text-align: center; position: relative; }
+    .step .dot {
+      width: 38px; height: 38px; border-radius: 50%; margin: 0 auto 6px;
+      display: flex; align-items: center; justify-content: center;
+      background: #e9ecef; color: #6c757d; font-weight: bold;
+      border: 2px solid #dee2e6; position: relative; z-index: 1;
+    }
+    .step.done .dot { background: #198754; border-color: #198754; color: #fff; }
+    .step.current .dot {
+      background: #0d6efd; border-color: #0d6efd; color: #fff;
+      box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.2);
+    }
+    .step .lbl { font-size: 0.78rem; color: #6c757d; }
+    .step.done .lbl { color: #198754; }
+    .step.current .lbl { font-weight: bold; color: #0d6efd; }
+    .step::before {
+      content: ""; position: absolute; top: 19px; left: -50%;
+      width: 100%; height: 3px; background: #dee2e6;
+    }
+    .step:first-child::before { display: none; }
+    .step.done::before, .step.current::before { background: #198754; }
+  </style>
+</head>
+<body class="bg-light">
+  <div class="container py-5" style="max-width: 760px">
+    <div class="text-center mb-4">
+      <a href="index.html" class="text-decoration-none text-dark"><h4>🪑 Vaishnavi Furniture</h4></a>
+      <h2>📦 Track Your Order</h2>
+      <p class="text-muted">Enter the Order ID you received at checkout.</p>
+    </div>
+
+    <form id="track-form" class="d-flex gap-2 mb-4">
+      <input id="order-id-input" class="form-control" placeholder="Paste your Order ID here" autocomplete="off" />
+      <button class="btn btn-primary" type="submit">Track</button>
+    </form>
+
+    <div id="track-result"></div>
+  </div>
+
+  <script type="module">
+    import { db } from "./assets/js/firebase.js";
+    import { doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
+
+    const STAGES = [
+      { id: "received", label: "Received" },
+      { id: "confirmed", label: "Confirmed" },
+      { id: "in_production", label: "In Production" },
+      { id: "ready", label: "Ready for Delivery" },
+      { id: "out_for_delivery", label: "Out for Delivery" },
+      { id: "delivered", label: "Delivered" },
+    ];
+    const LEGACY = {
+      new: "received",
+      "in-progress": "in_production",
+      shipped: "out_for_delivery",
+      delivered: "delivered",
+    };
+    const norm = (s) => LEGACY[s] || s || "received";
+    const esc = (s) =>
+      String(s ?? "").replace(/[&<>"']/g, (c) => ({
+        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
+      }[c]));
+    const fmtDate = (iso) => {
+      if (!iso) return "—";
+      return new Date(iso).toLocaleString("en-IN", {
+        day: "numeric", month: "short", year: "numeric",
+        hour: "2-digit", minute: "2-digit",
+      });
+    };
+
+    function stepperHtml(status) {
+      if (status === "cancelled") {
+        return `<div class="alert alert-danger text-center">❌ This order was cancelled. Please contact the shop for details.</div>`;
+      }
+      let idx = STAGES.findIndex((s) => s.id === status);
+      if (idx < 0) idx = 0;
+      const steps = STAGES.map((s, i) => {
+        const cls = i < idx ? "done" : i === idx ? "current" : "";
+        const mark = i < idx ? "✓" : i + 1;
+        return `<div class="step ${cls}"><div class="dot">${mark}</div><div class="lbl">${s.label}</div></div>`;
+      }).join("");
+      return `<div class="stepper">${steps}</div>`;
+    }
+
+    function historyHtml(order) {
+      const h = order.statusHistory || [];
+      if (!h.length) return "";
+      const items = [...h]
+        .reverse()
+        .map((e) => {
+          const id = norm(e.status);
+          const lbl = (STAGES.find((s) => s.id === id) || { label: id }).label;
+          return `<li class="mb-1"><strong>${esc(lbl)}</strong> <small class="text-muted">· ${fmtDate(e.at)}</small></li>`;
+        })
+        .join("");
+      return `<h6 class="mt-3">Order Journey</h6><ul class="small ps-3 mb-0">${items}</ul>`;
+    }
+
+    function errorHtml(msg) {
+      return `<div class="alert alert-warning text-center">${esc(msg)}</div>`;
+    }
+
+    function orderHtml(id, order) {
+      const status = norm(order.orderStatus);
+      const items = (order.items || [])
+        .map((i) => `<li>${esc(i.qty)} × <span class="text-muted">${esc(i.productId)}</span></li>`)
+        .join("");
+      return `
+        <div class="card shadow-sm">
+          <div class="card-body">
+            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
+              <h5 class="mb-0">Order <code>${esc(id)}</code></h5>
+              <small class="text-muted">Placed: ${fmtDate(order.createdAt)}</small>
+            </div>
+            ${stepperHtml(status)}
+            <hr />
+            <div class="row">
+              <div class="col-md-6">
+                <h6>Items</h6>
+                <ul class="small ps-3">${items || "<li>—</li>"}</ul>
+              </div>
+              <div class="col-md-6">
+                <h6>Summary</h6>
+                <p class="small mb-1">Customer: <strong>${esc(order.customer && order.customer.name)}</strong></p>
+                <p class="small mb-1">Total: <strong>₹${Number(order.total || 0).toLocaleString("en-IN")}</strong></p>
+                <p class="small mb-0 text-muted">Last update: ${fmtDate(order.updatedAt)}</p>
+              </div>
+            </div>
+            ${historyHtml(order)}
+          </div>
+        </div>`;
+    }
+
+    async function trackOrder(id) {
+      const box = document.getElementById("track-result");
+      id = (id || "").trim();
+      if (!id || id.includes("/")) {
+        box.innerHTML = errorHtml("Please enter a valid Order ID.");
+        return;
+      }
+      box.innerHTML = `<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>`;
+      try {
+        const snap = await getDoc(doc(db, "orders", id));
+        if (!snap.exists()) {
+          box.innerHTML = errorHtml("No order found with this ID. Please check it and try again.");
+          return;
+        }
+        box.innerHTML = orderHtml(id, snap.data());
+        history.replaceState(null, "", `track-order.html?id=${encodeURIComponent(id)}`);
+      } catch (e) {
+        console.error(e);
+        box.innerHTML = errorHtml("Could not load this order right now. Please try again later.");
+      }
+    }
+
+    document.getElementById("track-form").addEventListener("submit", (e) => {
+      e.preventDefault();
+      trackOrder(document.getElementById("order-id-input").value);
+    });
+
+    const qid = new URLSearchParams(location.search).get("id");
+    if (qid) {
+      document.getElementById("order-id-input").value = qid;
+      trackOrder(qid);
+    }
+  </script>
+</body>
+</html>
